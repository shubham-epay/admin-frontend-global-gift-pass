# Base URL the browser calls. Keep "/api" when the admin UI and API are served from the same origin
# (recommended: serve /api via reverse proxy on the admin domain). Otherwise e.g. https://api.globalgiftpass.com/api
VITE_API_BASE_URL=/api
# Dev only: where Vite proxies /api to
VITE_API_PROXY_TARGET=http://localhost:5000
